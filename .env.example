# SafeBooks environment configuration
# Copy this file to .env and update values for your machine.

# 0 = SQLite mode (default)
# 1 = PostgreSQL mode
SAFEBOOKS_USE_POSTGRESQL=0

# PostgreSQL settings (used only when SAFEBOOKS_USE_POSTGRESQL=1)
SAFEBOOKS_DB_NAME=safebooks_db
SAFEBOOKS_DB_USER=safebooks_user
SAFEBOOKS_DB_PASSWORD=replace_me
SAFEBOOKS_DB_HOST=localhost
SAFEBOOKS_DB_PORT=5432
# Optional: disable if not needed in local development
# SAFEBOOKS_DB_SSLMODE=prefer

# Optional compatibility aliases (if you already use these names)
# POSTGRES_DB=safebooks_db
# POSTGRES_USER=safebooks_user
# POSTGRES_PASSWORD=replace_me
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Email (SMTP) settings
# When SAFEBOOKS_EMAIL_HOST is set, SMTP will be used automatically.
# Do not store real credentials here. Put them in your local .env file.
SAFEBOOKS_EMAIL_HOST=smtp.gmail.com
SAFEBOOKS_EMAIL_PORT=587
SAFEBOOKS_EMAIL_HOST_USER=your_gmail@gmail.com
SAFEBOOKS_EMAIL_HOST_PASSWORD=replace_me
SAFEBOOKS_EMAIL_USE_TLS=1
SAFEBOOKS_EMAIL_USE_SSL=0
SAFEBOOKS_DEFAULT_FROM_EMAIL=SafeBooks <your_gmail@gmail.com>
SAFEBOOKS_CLIENT_RECORD_EMAILS_ENABLED=1
SAFEBOOKS_APPROVAL_DECISION_EMAILS_ENABLED=1
# Optional override if you want to force a backend
# SAFEBOOKS_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Temporary remote-beta feedback. Keep the real recipient only in .env.
SAFEBOOKS_FEEDBACK_ENABLED=0
SAFEBOOKS_FEEDBACK_RECIPIENT_EMAIL=developer@example.com
SAFEBOOKS_FEEDBACK_EMAIL_TIMEOUT_SECONDS=10
SAFEBOOKS_FEEDBACK_RATE_LIMIT_COUNT=5
SAFEBOOKS_FEEDBACK_RATE_LIMIT_WINDOW_SECONDS=600

# Google OAuth login/signup
# Create these in Google Cloud Console and keep real values only in .env/deployment secrets.
SAFEBOOKS_GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
SAFEBOOKS_GOOGLE_OAUTH_CLIENT_SECRET=replace_me
# Optional. Leave blank to use the current host callback URL automatically.
# Local callback usually looks like: http://127.0.0.1:8000/auth/google/callback/
SAFEBOOKS_GOOGLE_OAUTH_REDIRECT_URI=

# Admin security session policy (seconds)
SAFEBOOKS_ADMIN_SESSION_MAX_AGE_SECONDS=28800
SAFEBOOKS_ADMIN_SESSION_IDLE_TIMEOUT_SECONDS=1800
SAFEBOOKS_ADMIN_TWO_FACTOR_PENDING_TIMEOUT_SECONDS=300
SAFEBOOKS_ADMIN_TWO_FACTOR_LOGIN_TIMEOUT_SECONDS=300
SAFEBOOKS_ADMIN_TWO_FACTOR_LOGIN_MAX_ATTEMPTS=5
SAFEBOOKS_ADMIN_TWO_FACTOR_LOGIN_LOCKOUT_SECONDS=300

# Set both to 1 in HTTPS production deployments. Keep them at 0 for local HTTP.
SAFEBOOKS_SESSION_COOKIE_SECURE=0
SAFEBOOKS_CSRF_COOKIE_SECURE=0
